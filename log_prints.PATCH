diff --git a/Log.gd b/Log.gd
index 62d8e53..066a7bc 100644
--- a/Log.gd
+++ b/Log.gd
@@ -1,19 +1,34 @@
 extends Node
 
-# Categories for logging. Add more here as your project grows.
-enum Category { PHYSICS, SHIFT, CHUTE, WHEELS, GENERAL }
+enum Category {
+	PHYSICS, SHIFT, CHUTE, WHEELS, GENERAL, LATERAL, ENGINE, SETUP,
+	TREE, TIMING, RACE, CAMERA, UI, WORLD, TEST,
+}
 
-# Toggle these on/off to control what prints to the console.
-# true = prints, false = silent
+# Turn any category on (true) or off (false) here. Nothing else to touch.
 var enabled: Dictionary = {
 	Category.PHYSICS: true,
 	Category.SHIFT: false,
 	Category.CHUTE: false,
 	Category.WHEELS: false,
-	Category.GENERAL: false, # Keep general on for now
+	Category.GENERAL: false,
+	Category.LATERAL: false,   # tire sideways-slip spam, every 0.25s
+	Category.ENGINE: true,
+	Category.SETUP: true,      # startup / config messages
+	Category.TREE: true,
+	Category.TIMING: true,
+	Category.RACE: true,
+	Category.CAMERA: true,
+	Category.UI: true,
+	Category.WORLD: true,      # fish, weeds, water, fps
+	Category.TEST: true,
 }
 
-# The main logging function. Call this instead of print().
-func d(category: Category, msg: String) -> void:
-	if enabled.get(category, false):
-		print(msg)
+
+func is_on(category: Category) -> bool:
+	return enabled.get(category, false)
+
+# Use instead of print(). Takes any number of things, like print().
+func d(category: Category, ...args: Array) -> void:
+	if is_on(category):
+		print("".join(args.map(str)))
